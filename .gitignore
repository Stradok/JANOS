# System temp files
temp/

# Python virtual environments
jarvis-core/venv/
jarvis-core/.venv/

# JANOS runtime state — regenerated, and personal
jarvis-core/memory/*.db
jarvis-core/memory/*.db-journal
jarvis-core/memory/chroma_db/
jarvis-core/memory/chroma_episodic/
jarvis-core/workspace/
jarvis-core/memory/worktrees/
jarvis-core/memory/employee-state/

# Tools JANOS wrote for itself — machine-written, rebuilt on demand
jarvis-core/janos/generated/*.py
!jarvis-core/janos/generated/__init__.py
jarvis-core/janos/playbooks/*.json

# Python bytecode
__pycache__/
*.pyc
*.pyo

# OS files
Thumbs.db
desktop.ini
.DS_Store

# Copilot tool output
copilot-tool-output-*

# secrets
jarvis-core/.brave_key
jarvis-core/memory/api_token
jarvis-core/memory/launch.html
jarvis-core/memory/models/
jarvis-core/memory/policy.npz*
jarvis-core/memory/policy.lock
jarvis-core/memory/autorun.pid

# HUD build output and deps
jarvis-core/janos/ui_dist/
UI/janos-hud/node_modules/
